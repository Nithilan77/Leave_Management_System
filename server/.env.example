# ---- Server ----
# Port the API listens on
PORT=5000

# Current environment: development | production | test
NODE_ENV=development

# ---- Database ----
# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/lms
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lms
MONGO_URI=mongodb://127.0.0.1:27017/lms

# ---- Auth ----
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
# How long a login token stays valid
JWT_EXPIRES_IN=1d

# ---- Client ----
# The frontend origin allowed by CORS (Vite dev server default)
CLIENT_URL=http://localhost:5173

# ---- Email (Resend) ----
# Get a free API key at https://resend.com/api-keys
# If this is left unset, the app logs what WOULD have been sent instead of
# making a network call — safe default for local dev / CI, nothing breaks.
RESEND_API_KEY=re_2pRpg4pw_DZ1JngX8gkYFQL875qSWGAiw
# Sandbox sender that works without verifying your own domain on Resend.
# Swap to your own verified domain's address before a real deployment.
EMAIL_FROM=Leave Management System <onboarding@resend.dev>

# ---- Demo seed data ----
# Resend's sandbox sender (onboarding@resend.dev) can only deliver to the
# email you signed up to Resend with. Set this to that same address so the
# seeded manager account's email-notification demo actually lands in an
# inbox you'll have open during the presentation. Optional — defaults to
# manager@lms.com (no real email will be sent) if left unset.
DEMO_MANAGER_EMAIL=nithilan7437@gmail.com