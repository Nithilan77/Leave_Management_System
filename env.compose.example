# Copy this to .env (same folder as docker-compose.yml) and fill in real values.
# This file is for `docker compose up` only — it is separate from server/.env,
# which is used when running the server directly with `npm run dev`.
#
# This file (env.compose.example) itself holds NO real secrets and is safe
# to commit. The .env you create FROM it is NOT safe to commit — it stays
# git-ignored.

PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/lms?retryWrites=true&w=majority&appName=LeaveManagementSystem

# ---- Auth ----
# Generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1000d

# ---- Client ----
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
